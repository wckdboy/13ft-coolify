# Copy to .env for local `docker compose up`, or paste these keys into
# Coolify's Environment Variables tab (Coolify keeps its own .env).

# UI language of the 13ft app: en | de | fr | ko
LOCALE=en

TZ=UTC

# --- tuning (see README "Why these gunicorn settings") ---
# Concurrency inside the single worker. Raise it if you expect many
# simultaneous fetches; the app is I/O bound while fetching.
GUNICORN_THREADS=8
# Must exceed the app's own HTTP timeout (~30s) with headroom.
GUNICORN_TIMEOUT=180

# docker-compose.simple.yml only: host port for local testing
HOST_PORT=8080
